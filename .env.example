# Support email delivery. Both of these are required in any environment that
# should actually send mail; a static export cannot host the support form at all
# because the transport uses Node's https module.
MAILERSEND_API_TOKEN=
MAILERSEND_FROM_EMAIL=support@lifepoem.one
CONTACT_TO_EMAIL=support@lifepoem.one

# Transport selection. Defaults to "mailersend" when unset, so leaving this out
# of production is the correct and safe thing to do.
#
# "stub" records messages to CONTACT_OUTBOX instead of sending them, which is how
# the end-to-end suite asserts on the delivered payload. It is refused under
# NODE_ENV=production unless CONTACT_TRANSPORT_STUB_ACK is also set.
# CONTACT_TRANSPORT=stub
# CONTACT_OUTBOX=.contact-outbox.jsonl
# CONTACT_TRANSPORT_STUB_ACK=i-understand-no-email-will-be-sent

# Absolute origin, used for canonical URLs, hreflang alternates, the sitemap and
# OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=https://lifepoem.one
